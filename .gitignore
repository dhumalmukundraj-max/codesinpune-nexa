    # ==========================================
# Er.NEXA - Git Ignore Rules
# ==========================================

# 1. Environment & Sensitive Credentials (CRITICAL - never commit keys!)
.env
.env.local
.env.*.local
*.env

# 2. Dependencies (Root, Client, and Server)
node_modules/
client/node_modules/
server/node_modules/
.pnp
.pnp.js

# 3. Production Build Outputs
dist/
client/dist/
server/dist/
build/
out/

# 4. Uploads & Temporary File Processing
uploads/
server/uploads/
temp/
tmp/
*.zip
*.tar.gz

# 5. Electron Desktop App Packaging Outputs
node_modules/electron/dist/electron.exe
release/
dist-electron/
*.exe
*.dmg
*.AppImage

# 6. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. IDE, Editor & OS Artifacts
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# 8. Testing & Coverage
coverage/
.nyc_output/